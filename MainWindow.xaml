<Window x:Class="MusicEdge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MusicEdgeX"
        Width="372" Height="512"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Display"
        d:DesignWidth="372" d:DesignHeight="512">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF1ECE3"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFA09B92"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF6A665F"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1CFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC9604A"/>

        <DrawingBrush x:Key="GrainBrush" TileMode="Tile" Viewport="0,0,5,5"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M0,0 H5 V5 H0 Z"/>
                    <GeometryDrawing Brush="#07FFFFFF" Geometry="M0,0 H1 V1 H0 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="19" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#11FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ScaleHost" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="#FFF1ECE3"/>
                            <Ellipse Margin="4" Stroke="#22FFFFFF" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScaleHost" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ScaleHost" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="#14FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekRepeatBase" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="2" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SeekRepeatBase}"
                                                  Background="{DynamicResource AccentBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="10" Height="10" Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource TextPrimary}"
                                                         Width="10" Height="10"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SeekRepeatBase}"
                                                  Background="#2AFFFFFF"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource SeekSlider}">
            <Setter Property="Height" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Border x:Name="PanelBorder" CornerRadius="16,0,0,16"
                Background="#FF0D0D0F"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,1,0,1">
            <Grid>
                <Rectangle Fill="{StaticResource GrainBrush}" IsHitTestVisible="False"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColRail" Width="56"/>
                        <ColumnDefinition x:Name="ColContent" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Collapsed rail: a vertical line of lyric, a sleeve and a transport key -->
                    <Border x:Name="Rail" Grid.Column="0" CornerRadius="16,0,0,16"
                            BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
                        <Grid Margin="8,14,8,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="MiniArtFrame" Width="40" Height="40" CornerRadius="10"
                                    Background="#18181A" BorderBrush="#22FFFFFF" BorderThickness="1"
                                    RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid>
                                    <Path Data="M12,3v10.55c-0.59,-0.34 -1.27,-0.55 -2,-0.55 -2.21,0 -4,1.79 -4,4s1.79,4 4,4 4,-1.79 4,-4V7h4V3h-6z"
                                          Fill="{StaticResource TextMuted}" Width="15" Height="15"
                                          Stretch="Uniform" Opacity="0.5"/>
                                    <Border x:Name="MiniArtLayer" CornerRadius="9" Opacity="0">
                                        <Border.Background>
                                            <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse x:Name="RailPlayingDot" Width="5" Height="5"
                                             Fill="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,3,3" Opacity="0"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="RailLyricPanel" Grid.Row="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Width="42"/>

                            <Button x:Name="BtnRailPlay" Grid.Row="2" Style="{StaticResource RailButton}"
                                    Click="BtnPlayPause_Click" ToolTip="播放 / 暂停">
                                <Path x:Name="RailPlayIcon" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{StaticResource TextPrimary}" Data="M8,5v14l11,-7z"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid x:Name="ContentPanel" Grid.Column="1" Margin="20,14,20,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="112"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MUSIC EDGE" Foreground="{StaticResource TextSecondary}"
                                           FontSize="8.5" FontWeight="SemiBold"
                                           Typography.Capitals="AllSmallCaps"/>
                                <TextBlock x:Name="TxtSource" Text="未连接"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="9.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="BtnPin" Style="{StaticResource IconButton}"
                                        Click="BtnPin_Click" ToolTip="固定面板">
                                    <Path Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M16,9V4l1,0c0.55,0 1,-0.45 1,-1v0c0,-0.55 -0.45,-1 -1,-1H7C6.45,2 6,2.45 6,3v0c0,0.55 0.45,1 1,1l1,0v5c0,1.66 -1.34,3 -3,3h0v2h5.97v7l1,1l1,-1v-7H19v-2h0C17.34,12 16,10.66 16,9z"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="BtnClose_Click"
                                        ToolTip="隐藏面板" Margin="2,0,0,0">
                                    <Path Width="11" Height="11" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Sleeve + identity -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AlbumFrame" Width="104" Height="104" CornerRadius="14"
                                    Background="#18181A" BorderBrush="#22FFFFFF" BorderThickness="1"
                                    RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid>
                                    <Path Data="M12,3v10.55c-0.59,-0.34 -1.27,-0.55 -2,-0.55 -2.21,0 -4,1.79 -4,4s1.79,4 4,4 4,-1.79 4,-4V7h4V3h-6z"
                                          Fill="{StaticResource TextMuted}" Width="34" Height="34"
                                          Stretch="Uniform" Opacity="0.26"/>
                                    <Border x:Name="AlbumArtLayer" CornerRadius="13" Opacity="0">
                                        <Border.Background>
                                            <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="13" BorderBrush="#16FFFFFF" BorderThickness="1"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,1,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="TxtSongTitle" Text="未在播放"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="17" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxHeight="46"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtArtist" Text="把鼠标移到屏幕边缘"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11.5" Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtAlbum" Text=""
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="10" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border x:Name="SourceDotRow" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SourceDot" Width="4" Height="4"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSourceKind" Text="SMTC"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="8.5" Margin="5,0,0,0"
                                                   Typography.Capitals="AllSmallCaps"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Height="1" Background="#12FFFFFF" Margin="0,12,0,0"/>

                        <!-- Lyric page -->
                        <Grid x:Name="LyricBlock" Grid.Row="3" Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="LyricMarker" Width="2" Height="20"
                                       Fill="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,0,0"
                                       RadiusX="1" RadiusY="1" Opacity="0"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLyricPrev" Text=""
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="Songti SC, SimSun, Noto Serif CJK SC"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           Opacity="0.55" Margin="0,0,0,7"/>
                                <TextBlock x:Name="TxtLyricCurrent" Text="正在聆听"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="Songti SC, SimSun, Noto Serif CJK SC"
                                           FontSize="20" LineHeight="30"
                                           TextWrapping="Wrap">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="TxtLyricTranslation" Text=""
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Opacity="0.8"/>
                                <TextBlock x:Name="TxtLyricNext" Text=""
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="Songti SC, SimSun, Noto Serif CJK SC"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           Opacity="0.45" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Position -->
                        <Grid Grid.Row="4" Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider x:Name="SliderSeek" Style="{StaticResource SeekSlider}"
                                    Minimum="0" Maximum="1" Value="0"
                                    ValueChanged="SliderSeek_ValueChanged"
                                    PreviewMouseLeftButtonDown="SliderSeek_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SliderSeek_PreviewMouseLeftButtonUp"
                                    LostMouseCapture="SliderSeek_LostMouseCapture"/>
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtElapsed" Text="0:00"
                                           Foreground="{StaticResource TextMuted}" FontSize="9.5"
                                           FontFamily="Cascadia Mono, Consolas"/>
                                <TextBlock x:Name="TxtTotal" Text="0:00" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMuted}" FontSize="9.5"
                                           FontFamily="Cascadia Mono, Consolas"/>
                            </Grid>
                        </Grid>

                        <!-- Transport -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,8,0,0">
                            <Button x:Name="BtnShuffle" Style="{StaticResource TransportButton}"
                                    Width="34" Height="34" Click="BtnShuffle_Click"
                                    ToolTip="随机播放" Margin="0,0,2,0">
                                <Path x:Name="ShuffleIcon" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M10.59,9.17L5.41,4 4,5.41l5.17,5.17 1.42,-1.41zM14.5,4l2.04,2.04L4,18.59 5.41,20 17.96,7.46 20,9.5V4h-5.5zM14.83,13.41l-1.41,1.41 3.13,3.13L14.5,20H20v-5.5l-2.04,2.04 -3.13,-3.13z"/>
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Width="40" Height="40"
                                    Click="BtnPrevious_Click" ToolTip="上一首" Margin="2,0,0,0">
                                <Path Width="17" Height="17" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M6,6h2v12H6zm3.5,6l8.5,6V6z"/>
                            </Button>
                            <Button x:Name="BtnPlayPause" Style="{StaticResource PlayButton}"
                                    Click="BtnPlayPause_Click" ToolTip="播放 / 暂停" Margin="8,0">
                                <Path x:Name="PlayIcon" Width="18" Height="18" Stretch="Uniform"
                                      Fill="#0C0C0E" Data="M8,5v14l11,-7z"/>
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Width="40" Height="40"
                                    Click="BtnNext_Click" ToolTip="下一首" Margin="0,0,2,0">
                                <Path Width="17" Height="17" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M6,18l8.5,-6L6,6v12zM16,6v12h2V6h-2z"/>
                            </Button>
                            <Button x:Name="BtnLike" Style="{StaticResource TransportButton}"
                                    Width="34" Height="34" Click="BtnLike_Click"
                                    ToolTip="收藏到 QQ 音乐">
                                <Path x:Name="LikeIcon" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M12,21.35l-1.45,-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78 -3.4,6.86 -8.55,11.54L12,21.35z"/>
                            </Button>
                        </StackPanel>

                        <!-- Footer -->
                        <Grid Grid.Row="6" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnMute" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" Click="BtnMute_Click" ToolTip="静音">
                                <Path x:Name="VolumeIcon" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M3,9v6h4l5,5V4L7,9H3z M16.5,12c0,-1.77 -1.02,-3.29 -2.5,-4.03v8.05c1.48,-0.73 2.5,-2.25 2.5,-4.02zM14,3.23v2.06c2.89,0.86 5,3.54 5,6.71s-2.11,5.85 -5,6.71v2.06c4.01,-0.91 7,-4.49 7,-8.77s-2.99,-7.86 -7,-8.77z"/>
                            </Button>
                            <Slider x:Name="SliderVolume" Grid.Column="1" Style="{StaticResource VolumeSlider}"
                                    Minimum="0" Maximum="100" Value="50" Margin="7,0,7,0"
                                    ValueChanged="SliderVolume_ValueChanged"
                                    PreviewMouseWheel="SliderVolume_PreviewMouseWheel"/>
                            <TextBlock x:Name="TxtVolume" Grid.Column="2" Text="50%"
                                       Foreground="{StaticResource TextMuted}" FontSize="9"
                                       Width="28" TextAlignment="Right"
                                       FontFamily="Cascadia Mono, Consolas"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnOpenPlayer" Grid.Column="3" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" Click="BtnPlaylist_Click"
                                    ToolTip="打开播放器" Margin="4,0,0,0">
                                <Path Width="13" Height="13" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M12,1c-4.97,0 -9,4.03 -9,9v7c0,1.66 1.34,3 3,3h3v-8H5v-2c0,-3.87 3.13,-7 7,-7s7,3.13 7,7v2h-4v8h3c1.66,0 3,-1.34 3,-3v-7c0,-4.97 -4.03,-9 -9,-9z"/>
                            </Button>
                            <Button x:Name="BtnSettings" Grid.Column="4" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" Click="BtnSettings_Click"
                                    ToolTip="设置" Margin="2,0,0,0">
                                <Path Width="13" Height="13" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
