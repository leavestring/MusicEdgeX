<Window x:Class="MusicEdge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicEdgeX" Width="372" Height="512"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Opacity="0"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8F1FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#C7BBD9"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A99ABB"/>
        <SolidColorBrush x:Key="PanelBaseBrush" Color="#201A33"/>
        <SolidColorBrush x:Key="RailBrush" Color="#2B2341"/>
        <SolidColorBrush x:Key="LineBrush" Color="#463858"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#CDB1FF"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="8" BorderThickness="1"
                                BorderBrush="Transparent" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#24D6BAFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#3AD6BAFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#E1D1F7"/>
            <Setter Property="Foreground" Value="#201A33"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#F4E8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#CBB9E5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#332549"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#483761"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="SeekRepeatBase" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="3" VerticalAlignment="Center" CornerRadius="1.5"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="SmallChange" Value="5"/>
            <Setter Property="LargeChange" Value="15"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderSurface" Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SeekRepeatBase}"
                                                  Background="{DynamicResource AccentBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="10" Height="10">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource TextPrimary}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SeekRepeatBase}" Background="#534465"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderSurface" Property="Background" Value="#24D6BAFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LyricContext" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="TimeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Border x:Name="PanelBorder" CornerRadius="16,0,0,16"
                Background="{StaticResource PanelBaseBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColRail" Width="56"/>
                    <ColumnDefinition x:Name="ColContent" Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Rail" Grid.Column="0" CornerRadius="16,0,0,16"
                        Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="8,17,8,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Width="38" Height="38" CornerRadius="9" Background="#3A3051"
                                HorizontalAlignment="Center">
                            <Grid>
                                <Path Width="15" Height="16" Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M9,17 V5 L20,3 V15 M9,17 C9,20 3,21 3,18 C3,15 9,14 9,17 M20,15 C20,18 14,19 14,16 C14,13 20,12 20,15"/>
                                <Border x:Name="MiniArtLayer" CornerRadius="9" Opacity="0">
                                    <Border.Background><ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/></Border.Background>
                                </Border>
                                <Ellipse x:Name="RailPlayingDot" Width="7" Height="7" Margin="0,0,3,3"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Fill="{DynamicResource AccentBrush}" Stroke="#241D36" StrokeThickness="1"
                                         Opacity="0"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="RailLyricMark" Width="12" Height="1" Margin="0,0,0,14"
                                       Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="TxtRailLyric" Grid.Row="1" Text="待&#x0a;机"
                                       FontSize="13" FontWeight="Medium" TextAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="152"
                                       LineHeight="22" LineStackingStrategy="BlockLineHeight"/>
                        </Grid>
                        <Button x:Name="BtnRailPlay" Grid.Row="2" Style="{StaticResource RailButton}"
                                Click="BtnPlayPause_Click" ToolTip="播放" IsEnabled="False">
                            <Path x:Name="RailPlayIcon" Width="11" Height="12" Stretch="Uniform"
                                  Fill="{StaticResource TextPrimary}" Data="M8,5v14l11,-7z"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid x:Name="ContentPanel" Grid.Column="1" Margin="20,17,19,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <TextBlock x:Name="TxtSource" Text="待机" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,100,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnSettings" Style="{StaticResource IconButton}"
                                    Click="BtnSettings_Click" ToolTip="设置">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4,6 H20 M4,12 H20 M4,18 H20 M8,3 V9 M15,9 V15 M11,15 V21"/>
                            </Button>
                            <Button x:Name="BtnPin" Style="{StaticResource IconButton}" Click="BtnPin_Click" ToolTip="固定面板">
                                <Path Width="13" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.55" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M8,3 H16 M9,3 V9 L6,13 H18 L15,9 V3 M12,13 V21"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="BtnClose_Click" ToolTip="隐藏面板">
                                <Path Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M5,5 L19,19 M19,5 L5,19"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TrackHeader" Grid.Row="1" Margin="0,0,0,15" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="53"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="53" Height="53" CornerRadius="9" Background="#332948">
                            <Grid>
                                <Path Width="19" Height="20" Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M9,17 V5 L20,3 V15 M9,17 C9,20 3,21 3,18 C3,15 9,14 9,17 M20,15 C20,18 14,19 14,16 C14,13 20,12 20,15"/>
                                <Border x:Name="AlbumArtLayer" CornerRadius="9" Opacity="0">
                                    <Border.Background><ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill"/></Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSongTitle" Text="未在播放" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="TxtArtist" Text="MusicEdgeX" FontSize="12" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <Button x:Name="BtnOpenPlayer" Grid.Column="2" Style="{StaticResource IconButton}"
                                Click="BtnPlaylist_Click" ToolTip="打开播放器" Visibility="Collapsed">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M20,13 V20 H4 V4 H11 M13,4 H20 V11 M20,4 L11,13"/>
                        </Button>
                    </Grid>

                    <Grid x:Name="LyricBlock" Grid.Row="2" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
                        <StackPanel Margin="0,8,0,8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLyricPrev" Style="{StaticResource LyricContext}" Margin="13,0,0,12"/>
                            <Grid>
                                <Border x:Name="LyricLightLayer" Margin="0,-7,0,-7" Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.72" EndPoint="1,0.28">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform x:Name="LyricLightShift"/>
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop x:Name="LyricLightOuter" Color="#12CDB1FF" Offset="0.24"/>
                                            <GradientStop x:Name="LyricLightCenter" Color="#44CDB1FF" Offset="0.40"/>
                                            <GradientStop Color="Transparent" Offset="0.73"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Rectangle x:Name="LyricAccent" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                                           Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="TxtLyricCurrent" Text="等一首歌" Margin="13,0,0,0"
                                           Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                           LineHeight="32" LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="96">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                            <TextBlock x:Name="TxtLyricTranslation" Margin="13,5,0,0" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                       LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="34"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="请在 QQ 音乐、网易云音乐等客户端开始播放。"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtLyricNext" Style="{StaticResource LyricContext}" Margin="13,11,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBridgeStatus" Grid.Row="1" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,1,0,9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Slider x:Name="SliderSeek" Style="{StaticResource SeekSlider}"
                                Minimum="0" Maximum="1" IsEnabled="False"
                                AutomationProperties.Name="播放进度"
                                PreviewMouseLeftButtonDown="SliderSeek_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SliderSeek_PreviewMouseLeftButtonUp"
                                LostMouseCapture="SliderSeek_LostMouseCapture"
                                MouseLeave="SliderSeek_MouseLeave"
                                PreviewKeyDown="SliderSeek_PreviewKeyDown"
                                ValueChanged="SliderSeek_ValueChanged"/>
                        <TextBlock x:Name="TxtElapsed" Text="--:--" Grid.Row="1" Style="{StaticResource TimeText}"/>
                        <TextBlock x:Name="TxtTotal" Text="--:--" Grid.Row="1" HorizontalAlignment="Right"
                                   Style="{StaticResource TimeText}"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Button x:Name="BtnShuffle" Style="{StaticResource IconButton}" IsEnabled="False"
                                    HorizontalAlignment="Left" Click="BtnShuffle_Click" ToolTip="随机播放">
                                <Path x:Name="ShuffleIcon" Width="16" Height="15" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M3,7 H7 L17,17 H21 M18,5 L21,7 L18,9 M3,17 H7 L17,7 H21 M18,15 L21,17 L18,19"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnPrevious" Style="{StaticResource IconButton}"
                                        Width="37" Height="38" IsEnabled="False" Click="BtnPrevious_Click" ToolTip="上一首">
                                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource TextPrimary}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Data="M7,6 V18 M18,6 L7,12 L18,18 Z"/>
                                </Button>
                                <Button x:Name="BtnPlayPause" Style="{StaticResource PlayButton}" Margin="8,0"
                                        IsEnabled="False" Click="BtnPlayPause_Click" ToolTip="播放">
                                    <Path x:Name="PlayIcon" Width="15" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M8,5v14l11,-7z"/>
                                </Button>
                                <Button x:Name="BtnNext" Style="{StaticResource IconButton}"
                                        Width="37" Height="38" IsEnabled="False" Click="BtnNext_Click" ToolTip="下一首">
                                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource TextPrimary}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Data="M17,6 V18 M6,6 L17,12 L6,18 Z"/>
                                </Button>
                            </StackPanel>
                            <Button x:Name="BtnLike" Style="{StaticResource IconButton}" IsEnabled="False"
                                    HorizontalAlignment="Right" Click="BtnLike_Click" ToolTip="收藏到 QQ 音乐">
                                <Path Width="16" Height="15" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round"
                                      Data="M12,20 C12,20 4,15 4,9.5 C4,6.5 6.5,4.5 9,4.5 C10.5,4.5 11.5,5.2 12,6 C12.5,5.2 13.5,4.5 15,4.5 C17.5,4.5 20,6.5 20,9.5 C20,15 12,20 12,20 Z"/>
                            </Button>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,12,0,0" Padding="0,5,0,0"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnMute" Style="{StaticResource IconButton}"
                                        Width="24" Height="26" Click="BtnMute_Click" ToolTip="静音">
                                    <Path x:Name="VolumeIcon" Width="15" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M4,9 H8 L12,5 V19 L8,15 H4 Z M15.5,9.5 C16.5,10.5 17,11.2 17,12 C17,12.8 16.5,13.5 15.5,14.5 M18,7 C20,8.5 21,10.1 21,12 C21,13.9 20,15.5 18,17"/>
                                </Button>
                                <Slider x:Name="SliderVolume" Grid.Column="1" Style="{StaticResource SeekSlider}"
                                        AutomationProperties.Name="系统音量" Minimum="0" Maximum="100"
                                        Value="50" VerticalAlignment="Center" Margin="8,0,8,0"
                                        ValueChanged="SliderVolume_ValueChanged"
                                        PreviewMouseWheel="SliderVolume_PreviewMouseWheel"/>
                                <TextBlock x:Name="TxtVolume" Grid.Column="2" Text="50%" Width="32" TextAlignment="Right"
                                           VerticalAlignment="Center" Style="{StaticResource TimeText}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="EdgeProgressHost" IsHitTestVisible="False" Width="2"
              HorizontalAlignment="Left" Margin="0,18,0,18">
            <Grid.RenderTransform><TranslateTransform x:Name="EdgeProgressShift"/></Grid.RenderTransform>
            <Rectangle Fill="#554269" RadiusX="1" RadiusY="1"/>
            <Rectangle x:Name="EdgeProgressFill" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1"
                       RenderTransformOrigin="0.5,1" Opacity="0">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Border x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="56,0,0,65" Padding="11,8" CornerRadius="8"
                Background="#3A2E52" BorderBrush="#665477" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10">
            <TextBlock x:Name="TxtToast" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
