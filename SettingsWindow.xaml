<Window x:Class="MusicEdge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MusicEdgeX 设置"
        Width="460" Height="700" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8F1FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#C7BBD9"/>
        <SolidColorBrush x:Key="TextMuted" Color="#AAA0BE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#CDB1FF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#463858"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EdgeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Padding="18,7" CornerRadius="10"
                                Background="#0CFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#00FFFFFF"/>
                                <Setter Property="Foreground" Value="#201A33"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22"
                                    CornerRadius="11" Background="#22FFFFFF">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#C7BBD9"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#201A33"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="20" Background="Transparent">
                                                    <Border Height="3" VerticalAlignment="Center"
                                                            Background="{StaticResource AccentBrush}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource TextPrimary}"
                                                         Width="12" Height="12"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="20" Background="Transparent">
                                                    <Border Height="3" VerticalAlignment="Center"
                                                            Background="#26FFFFFF"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#16FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Foreground" Value="#201A33"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.74"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="#302642"
                                BorderBrush="#16FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#28FFFFFF" CornerRadius="3" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            Background="#201A33">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0,18,0">
                    <TextBlock Text="MusicEdgeX 设置" Foreground="{StaticResource TextPrimary}" FontSize="20"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="BtnClose_Click"
                            ToolTip="关闭设置" AutomationProperties.Name="关闭设置">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{StaticResource TextSecondary}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,23,20">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="歌词与播放器"/>
                    <CheckBox x:Name="CbPlayerCap" Style="{StaticResource SwitchCheck}" Content="连接 PlayerCap 歌词桥接"/>
                    <Grid Margin="0,5,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="歌词同步"/>
                        <TextBlock x:Name="TxtLyricOffset" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextPrimary}" FontSize="12" FontFamily="Consolas"/>
                    </Grid>
                    <Slider x:Name="SliderLyricOffset" Style="{StaticResource SettingsSlider}"
                            AutomationProperties.Name="歌词同步偏移，毫秒"
                            IsSnapToTickEnabled="True" SmallChange="100" LargeChange="500" Margin="0,3,0,0"/>
                    <TextBlock Style="{StaticResource HintText}" Text="正值让歌词提前，负值让歌词延后。" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="服务地址" Target="{Binding ElementName=TxtCapHost}"
                                   Foreground="{StaticResource TextSecondary}" Padding="0,0,0,5"/>
                            <TextBox x:Name="TxtCapHost" Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="PlayerCap 服务地址"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="桥接播放器（可选）" Target="{Binding ElementName=TxtCapPlayer}"
                                   Foreground="{StaticResource TextSecondary}" Padding="0,0,0,5"/>
                            <TextBox x:Name="TxtCapPlayer" Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="桥接播放器"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="播放器留空时跟随 PlayerCap。填入 qqmusic 可固定桥接 QQ 音乐。"/>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Margin="0,20,0,0" Padding="0,17,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="屏幕边缘"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton x:Name="RbLeft" Style="{StaticResource EdgeRadio}" GroupName="Edge" Content="左侧边缘"/>
                                <RadioButton x:Name="RbRight" Style="{StaticResource EdgeRadio}" GroupName="Edge" Content="右侧边缘" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="悬停后展开延迟"/>
                                <TextBlock x:Name="TxtHoverValue" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimary}" FontSize="12" FontFamily="Consolas"/>
                            </Grid>
                            <Slider x:Name="SliderHover" Style="{StaticResource SettingsSlider}"
                                    AutomationProperties.Name="悬停后展开延迟"
                                    Minimum="100" Maximum="1200" TickFrequency="50" SmallChange="50"
                                    IsSnapToTickEnabled="True" Margin="0,3,0,9"/>
                            <Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="移开后收起延迟"/>
                                <TextBlock x:Name="TxtCollapseValue" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimary}" FontSize="12" FontFamily="Consolas"/>
                            </Grid>
                            <Slider x:Name="SliderCollapse" Style="{StaticResource SettingsSlider}"
                                    AutomationProperties.Name="移开后收起延迟"
                                    Minimum="200" Maximum="3000" TickFrequency="50" SmallChange="50"
                                    IsSnapToTickEnabled="True" Margin="0,3,0,9"/>
                            <Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="完全隐藏延迟"/>
                                <TextBlock x:Name="TxtHideValue" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimary}" FontSize="12" FontFamily="Consolas"/>
                            </Grid>
                            <Slider x:Name="SliderHide" Style="{StaticResource SettingsSlider}"
                                    AutomationProperties.Name="完全隐藏延迟"
                                    Minimum="500" Maximum="6000" TickFrequency="100" SmallChange="100"
                                    IsSnapToTickEnabled="True" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Margin="0,17,0,0" Padding="0,17,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="启动与全屏"/>
                            <CheckBox x:Name="CbFullscreen" Style="{StaticResource SwitchCheck}" Content="全屏时自动隐藏"/>
                            <CheckBox x:Name="CbAutoStart" Style="{StaticResource SwitchCheck}" Content="开机自动启动 MusicEdgeX"/>
                            <CheckBox x:Name="CbStartPinned" Style="{StaticResource SwitchCheck}" Content="启动后直接显示面板"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="24,0" LastChildFill="False">
                    <Button Style="{StaticResource GhostButton}" Content="恢复默认" DockPanel.Dock="Left"
                            Width="92" Click="BtnReset_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="保存设置" DockPanel.Dock="Right"
                            Width="100" Click="BtnSave_Click" IsDefault="True"/>
                    <Button Style="{StaticResource GhostButton}" Content="取消" DockPanel.Dock="Right"
                            Width="70" Margin="0,0,8,0" IsCancel="True"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
